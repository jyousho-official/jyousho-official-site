---
import { site, socialLinks } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <a class="brand footer-brand" href="/">
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">{site.shortName}</span>
    </a>
    <span class="footer-domain">{site.domain}</span>
    <nav aria-label="フッターナビゲーション">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-social" aria-label="SNSリンク">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label} data-icon={link.icon}>
          <Icon name={link.icon} size={16} />
        </a>
      ))}
    </div>
    <small>© 2026 {site.name} All Rights Reserved.</small>
  </div>
</footer>
