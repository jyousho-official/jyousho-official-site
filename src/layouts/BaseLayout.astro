---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, teams } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  theme?: 'home' | 'about' | 'teams' | 'works' | 'festival' | 'article';
  image?: string;
}

const {
  title,
  description = site.description,
  theme = 'home',
  image = '/images/placeholder.svg',
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);

const works = (await getCollection('works', ({ data }) => !data.draft)).map((entry) => ({
  path: `/works/${entry.id}`,
  title: entry.data.title,
  description: entry.data.description,
}));
const news = (await getCollection('news', ({ data }) => !data.draft)).map((entry) => ({
  path: `/news/${entry.id}`,
  title: entry.data.title,
  description: entry.data.description,
}));
const webmcpCatalog = {
  site: { name: site.name, shortName: site.shortName, domain: site.domain, description: site.description },
  pages: [{ path: '/', title: 'トップ' }, ...site.nav.map((item) => ({ path: item.href, title: item.label }))],
  teams: teams.map((team) => ({ id: team.id, name: team.name, description: team.description, activity: team.activity })),
  works,
  news,
};
---

<!doctype html>
<html lang="ja" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script type="application/json" id="webmcp-catalog" set:html={JSON.stringify(webmcpCatalog)} />
    <script src="/scripts/webmcp.js" type="module"></script>
  </body>
</html>
